# Clerk Authentication
# Get these from: https://dashboard.clerk.com → Your App → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx

# Clerk Webhook Secret
# Get this from: https://dashboard.clerk.com → Your App → Webhooks → Endpoint → Signing Secret
CLERK_WEBHOOK_SECRET=whsec_xxxxx

# Clerk Pro Plan ID
# This is the plan ID for the Pro subscription plan
CLERK_PRO_PLAN_ID=cplan_35lmOqzm4DkZ9qKirzLMaU5cImq

# Database
# Get this from your database provider (Neon, Supabase, etc.)
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL=postgresql://user:password@host:port/database?schema=public

# Google Gemini API
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Node Environment
# Set to 'production' for production deployments
NODE_ENV=production
