# Clerk Authentication
# Get these from: https://dashboard.clerk.com → Your App → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx

# Clerk Webhook Secret
# Get this from: https://dashboard.clerk.com → Your App → Webhooks → Endpoint → Signing Secret
CLERK_WEBHOOK_SECRET=whsec_xxxxx

# Clerk Pro Plan ID
# This is the plan ID for the Pro subscription plan
CLERK_PRO_PLAN_ID=cplan_35lmOqzm4DkZ9qKirzLMaU5cImq

# Database
# IMPORTANT: For serverless deployments (Vercel), use connection pooling!
# 
# Neon example (use pooled connection):
# DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require&pgbouncer=true&connect_timeout=15"
#
# Supabase example (use port 6543 for pooling):
# DATABASE_URL="postgresql://postgres:password@host.supabase.co:6543/postgres?pgbouncer=true&connect_timeout=15"
#
# Railway example:
# DATABASE_URL="postgresql://user:password@host.railway.app:5432/railway?schema=public"
#
# Add these parameters for serverless: &pgbouncer=true&connect_timeout=15&connection_limit=1
DATABASE_URL=postgresql://user:password@host:port/database?schema=public&pgbouncer=true&connect_timeout=15

# Google Gemini API
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Node Environment
# Set to 'production' for production deployments
NODE_ENV=production
