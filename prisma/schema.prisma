// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id // This will match the Clerk User ID
  email           String   @unique
  isPro           Boolean  @default(false) // Synced from Clerk subscription status
  clerkPlanId     String?  // Clerk plan ID (e.g., "pro", "premium")
  subscriptionId String?  // Clerk subscription ID
  createdAt       DateTime @default(now())
  updatedAt           DateTime @updatedAt
  onboardingCompleted Boolean  @default(false)
  profileCompleted    Boolean  @default(false)
  resumes             Resume[]
  jobs                JobApplication[]
  interviewSessions   InterviewSession[]
  equalEmployment     Json?    // Stores EEOC data (gender, veteran status, etc.)
  profileContent      Json?    // Decoupled profile data (Basics, Education, Experience, Skills)
}

model Resume {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("My Resume")
  content   Json     // Stores your entire ResumeSchema JSON here
  score     Int?
  isDefault Boolean  @default(false)
  source    String   @default("User") // "User" or "Extension"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobApplication {
  id               String   @id @default(cuid())
  userId           String
  company          String
  position         String
  status           String   // 'wishlist', 'applied', 'interview', 'offer', 'rejected'
  salary           String?
  url              String?
  
  // Extension & Tailoring Fields
  tailoredResumeId String?  // ID of the specific resume tailored for this job
  coverLetter      String?  @db.Text // Generated cover letter content
  jobDescription   String?  @db.Text // Full job description text
  source           String?  // e.g. "LinkedIn", "Indeed"

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InterviewSession {
  id               String    @id @default(cuid())
  userId           String
  roomName         String
  stage            String
  startedAt        DateTime  @default(now())
  endedAt          DateTime?
  jobApplicationId String?
  resumeId         String?
  events           InterviewEvent[]
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model InterviewEvent {
  id        String   @id @default(cuid())
  sessionId String
  ts        DateTime @default(now())
  stage     String
  role      String   // user | ai | system
  text      String?
  isFinal   Boolean  @default(false)
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, ts])
}
