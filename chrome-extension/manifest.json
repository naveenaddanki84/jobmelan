{
  "manifest_version": 3,
  "name": "JobMélan Copilot",
  "version": "2.0.0",
  "description": "AI-powered resume tailoring and job tracking directly from job postings",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "cookies",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*.jobmelan.com/*",
    "https://*.vercel.app/*",
    "<all_urls>"
  ],
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "JobMélan Copilot"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:3000/*",
        "https://*.jobmelan.com/*",
        "https://*.vercel.app/*"
      ],
      "js": ["content-script-inject.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icon128.png", "lever-auto-apply.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
